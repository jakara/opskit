# 仅供查阅字段，请运行 ./install.sh，由向导生成密码与完整配置。
OPS_PUBLIC_HOST=ops.example.internal
OPS_PUBLIC_SCHEME=https
OPS_PUBLIC_PORT=443
OPSKIT_BIND_IP=127.0.0.1
OPSKIT_HTTP_PORT=80
NPM_BIND_IP=127.0.0.1
NPM_ADMIN_PORT=8181
SPUG_HTTP_PORT=8081
OPSKIT_LOG_FORWARD_PORT=24224
NPM_ADMIN_EMAIL=admin@example.internal
NPM_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
SPUG_ADMIN_USER=admin
SPUG_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
SPUG_DB_PASSWORD=REPLACE_WITH_RANDOM
DBX_PASSWORD=REPLACE_WITH_RANDOM
OPS_ADMIN_USER=operator
OPS_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
LOG_AGENT_USER=logagent
LOG_AGENT_PASSWORD=REPLACE_WITH_RANDOM
LOG_INGEST_HOST=ops.example.internal
LOG_RETENTION_DAYS=14
WORKBENCH_IMAGE=m.daocloud.io/docker.io/library/python:3.12-alpine
NPM_IMAGE=m.daocloud.io/docker.io/jc21/nginx-proxy-manager:2.16.0
SPUG_IMAGE=ghcr.io/openspug/spug:4.1
MARIADB_IMAGE=m.daocloud.io/docker.io/library/mariadb:10.11
DBX_IMAGE=docker.cnb.cool/dbxio.com/dbx:0.6.40
VICTORIALOGS_IMAGE=m.daocloud.io/docker.io/victoriametrics/victoria-logs:v1.53.0
FLUENTBIT_IMAGE=m.daocloud.io/docker.io/fluent/fluent-bit:5.1.4
