# 由安装向导生成 .env；也可先复制管理端 collector.env 为 .env，再运行向导。
# OPS_HOST 是可连接的地址；OPS_VHOST 用于匹配 NPM 代理主机的域名。
OPS_HOST=ops.example.internal
OPS_PORT=80
OPS_VHOST=ops.example.internal
OPS_SCHEME=http
OPS_TLS=Off
HOST_ID=vm-01
PROJECT_ID=college-project
APP_ID=academic-service
APP_ENV=production
HOST_LOG_DIR=/var/log/myapp
LOG_FILE_PATTERN=*.log
# 使用管理端发放的日志写入凭据，不是运维入口登录凭据。
LOG_AGENT_USER=logagent
LOG_AGENT_PASSWORD=REPLACE_FROM_MANAGEMENT_ENV
FLUENTBIT_IMAGE=m.daocloud.io/docker.io/fluent/fluent-bit:5.1.4
